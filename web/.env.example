# VindicateDelegate deployments (leave empty until deployed on that network)
NEXT_PUBLIC_DELEGATE_BSC=
NEXT_PUBLIC_DELEGATE_BSC_TESTNET=

# HTTPS RPC endpoints. The Content-Security-Policy allows only these origins and the app's own.
# A private-transaction RPC here keeps rescues out of the public mempool.
NEXT_PUBLIC_RPC_BSC=https://bsc-dataseed.bnbchain.org
NEXT_PUBLIC_RPC_BSC_TESTNET=https://bsc-testnet-dataseed.bnbchain.org

# Optional practice assets on testnet (JSON, validated in src/lib/demo.ts). Addresses only.
# `pnpm dev:chain` writes this for the local chain.
NEXT_PUBLIC_DEMO_BSC_TESTNET=

# Server-side only (no NEXT_PUBLIC_ prefix): the credential for the rescue copilot's model.
# Without it the copilot still investigates and plans by rules, and says so.
ANTHROPIC_API_KEY=

# Optional, server only. An RPC for the copilot's investigation, which reads history with
# eth_getLogs over wide block ranges. Set it when the RPC above caps those (many keyed plans do).
COPILOT_RPC_BSC=
COPILOT_RPC_BSC_TESTNET=
